{
  "name": "@bayan1377/dsh-locale-ru",
  "version": "1.0.1",
  "description": "Russian (ru) language pack for the DeepSeek Harness web GUI: full interface translation, Russian system fonts and the ru-RU locale selected on load",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "data",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "deepseek",
    "harness",
    "locale",
    "i18n",
    "russian",
    "ru-RU",
    "translation"
  ],
  "author": "bayan1377",
  "license": "MIT"
}
